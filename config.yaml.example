# Copy to config.yaml (which is git-ignored) and fill in.
# With docker-compose, put config.yaml and .token in ./data (mounted at /data).

# Matrix homeserver base URL.
homeserver: https://aguiarvieira.pt

# Access token for the bot account. Either put it inline...
access_token: ""
# ...or point at a file containing it (used when access_token is empty).
# Relative paths are resolved against the directory containing this config file.
access_token_file: .token

# Rooms to monitor. The bot tries to join each of them on startup.
# Room IDs (!abc:server) or aliases (#room:server) are accepted.
rooms:
  - "!nmZrvcKkeQiFGRlJtE:aguiarvieira.pt"

# Optional GitHub token (falls back to $GITHUB_TOKEN). Without one, the GitHub
# API allows 60 requests/hour.
github_token: ""

# Other forges to watch links to. github.com, gitlab.com and codeberg.org are
# built in; list them here only to add a token. type is one of forgejo, gitea,
# gitlab or github (GitHub Enterprise). Links to hosts not listed are ignored.
forges:
  - url: https://git.eden-emu.dev
    type: forgejo
    # Optional API token (Forgejo/Gitea: an access token; GitLab: a personal
    # access token with read_api).
    token: ""

# Optional daily summary: each room gets one digest per day listing the commits
# and releases the bot posted about, grouped by repo. Long digests are split
# into several messages to stay under Matrix's 64 KiB event size limit.
summary:
  enabled: false
  # Local time to post it (HH:MM) and its IANA timezone.
  time: "23:59"
  timezone: UTC
  # Where the day's log is kept so it survives restarts (must be writable).
  # /state is the writable volume in docker-compose; for a local run use e.g.
  # summary.json (relative paths are resolved against this file's directory).
  # Leave empty to keep it in memory only.
  state_file: /state/summary.json
  # Commits listed per repo before "… and N more" (-1 for no limit).
  max_commits_per_repo: 50

# Optional threads: post the info into one thread per repo per room (as a reply
# to the message with the link, which also gets a 🧵 reaction) instead of the
# main timeline. The bot starts each thread with a short root message.
threads:
  enabled: false
  # Where thread roots are kept so restarts reuse the same threads. Leave
  # empty to keep them in memory only (new threads after each restart).
  state_file: /state/threads.json
